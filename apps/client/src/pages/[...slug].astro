---
import { prisma } from "@church/db";
import { toPuckData } from "@church/puck-config";
import { DEFAULT_CHURCH_SLUG } from "astro:env/server";
import Base from "../layouts/Base.astro";
import PuckPage from "../components/PuckPage";

// One Astro app serves every tenant, keyed off the request host:
// grace-chapel.example.com -> the "grace-chapel" church. A bare host
// (localhost, an IP) carries no tenant, so fall back to the dev default.
const hostname = Astro.url.hostname;
const isIpAddress = /^\d{1,3}(\.\d{1,3}){3}$/.test(hostname);
const isBareHost = isIpAddress || !hostname.includes(".");
const slug = isBareHost ? DEFAULT_CHURCH_SLUG : hostname.split(".")[0];

if (!slug) {
  return new Response("No church configured for this host", { status: 404 });
}

const path = "/" + (Astro.params.slug ?? "");
const normalizedPath = path === "/" ? "/" : path.replace(/\/+$/, "");

const page = await prisma.page.findFirst({
  where: { path: normalizedPath, church: { slug } },
  include: { church: true },
});

if (!page) {
  return new Response("Not found", { status: 404 });
}

const data = toPuckData(page.puckJson);
---

<Base title={page.church.name}>
  <!-- No client: directive => server-rendered HTML, zero JS shipped. -->
  <PuckPage data={data} />
</Base>
